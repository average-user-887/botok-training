{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROPOSED scribe candidate output v1, not deployed runtime contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "as_of",
    "items"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text",
          "owner",
          "due",
          "evidence"
        ],
        "properties": {
          "kind": {
            "enum": [
              "state",
              "decision",
              "pending",
              "uncertainty"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "due": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
